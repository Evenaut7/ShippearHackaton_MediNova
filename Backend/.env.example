DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=medinova
DB_DEBUG=false
# Con un MySQL gestionado fuera de la red privada (PlanetScale, Aiven, Railway por
# fuera de Railway) casi siempre hace falta SSL. Dentro de la red privada de
# Railway (mysql.railway.internal) NO hace falta.
DB_SSL=false
# Desactivar solo en serverless (Vercel): correr `npm run db:sync` a mano en su lugar.
DB_AUTO_SYNC=true

PORT=4000
CORS_ORIGIN=http://localhost:3000

GROQ_API_KEY=

# Se completa sola al crear un Blob store en el proyecto de Vercel (o con `vercel env pull`).
BLOB_READ_WRITE_TOKEN=
